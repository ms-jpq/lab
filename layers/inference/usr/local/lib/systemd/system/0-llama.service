[Unit]
Description      = llama.cpp

[Service]
Restart          = on-failure
RestartSec       = 5s
ProtectSystem    = strict
ProtectHome      = yes
PrivateTmp       = yes

RuntimeDirectory = local/%J
StateDirectory   = local/%J

Environment      = LLAMA_ARG_HOST=%t/local/%J/server.sock
Environment      = LLAMA_ARG_MODELS_MAX=1
Environment      = LLAMA_CACHE=%S/local/%J/models
EnvironmentFile  = -/usr/local/etc/default/%J.env

ExecStart        = /opt/llama.cpp/llama-server $ARGS
