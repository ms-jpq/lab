[Unit]
Description      = llama.cpp

[Service]
Restart          = on-failure
RestartSec       = 5s
ProtectSystem    = strict
ProtectHome      = yes
PrivateTmp       = yes

RuntimeDirectory = local/%J
CacheDirectory   = local/%J

Environment      = LLAMA_ARG_HOST=%t/local/%J/server.sock
Environment      = LLAMA_CACHE=%C/local/%J/cache
Environment      = LLAMA_ARG_MODELS_DIR=%C/local/%J/models
EnvironmentFile  = -/usr/local/etc/default/%J.env

ExecStartPre     = mkdir -p -- ${LLAMA_ARG_MODELS_DIR}
ExecStart        = /opt/llama.cpp/llama-server $ARGS
