user      root;
error_log stderr;

events {}

http {
  access_log off;

  server {
    listen [::]:80 ipv6only=off reuseport;

    location = / {
      auth_request /-_-validate;
      error_page   401 403 = @denied;
      try_files    /dev/null @accepted;
    }

    location = /-_-validate {
      internal;
      proxy_pass              http://unix:/run/local/nginx/htaccess.sock:/;
      proxy_pass_request_body off;
      proxy_set_header        Content-Length "";
    }

    location @denied {
      return 403;
    }

    location @accepted {
      return 200;
    }
  }
}
